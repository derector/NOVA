NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://nova:local_dev_only@127.0.0.1:5432/nova
DB_SSL=false
DB_POOL_MAX=10
# Replace before starting the service. Generate a private value with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_PRIVATE_RANDOM_32_BYTE_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated exact web origins; empty disables cross-origin browser access.
CORS_ORIGINS=http://localhost:3000

# Optional comma-separated ICE endpoints for browser calls across networks.
CALL_STUN_URLS=
CALL_TURN_URLS=
# Shared coturn use-auth-secret value; the API only returns expiring credentials.
CALL_TURN_SECRET=

# Assistant providers. Configure privately on the backend only.
NOVA_AI_OPENAI_KEY=
NOVA_AI_CHAT_MODEL=gpt-4o-mini
NOVA_AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
NOVA_AI_AZURE_SPEECH_KEY=
NOVA_AI_AZURE_SPEECH_REGION=
