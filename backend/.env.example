NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://nova:local_dev_only@127.0.0.1:5432/nova
# Replace before starting the service. Generate a private value with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_PRIVATE_RANDOM_32_BYTE_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Brevo SMTP example: smtp-relay.brevo.com, port 587, STARTTLS (SMTP_SECURE=false).
# SMTP_USER is the exact SMTP login shown in Brevo, not necessarily your account email.
# SMTP_PASSWORD must be a Brevo SMTP key, not an API key. Keep credentials out of Git.
# SMTP_FROM must be a sender verified in Brevo; authenticate your own sending domain for deliverability.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated exact web origins; empty disables cross-origin browser access.
CORS_ORIGINS=http://localhost:3000
