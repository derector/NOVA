{
  "name": "nova-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.spec.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/platform-socket.io": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express-rate-limit": "8.7.4",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "10.5.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
